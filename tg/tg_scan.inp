units           real
atom_style      full
boundary        p p p
pair_style      lj/charmmfsw/coul/long 10 12
pair_modify     mix arithmetic
bond_style      harmonic
angle_style     charmm
dihedral_style  charmmfsw
improper_style  harmonic
special_bonds   charmm
kspace_style    pppm 1e-6

read_data       start.data
neighbor        2.0 bin
neigh_modify    delay 5 every 1 check yes
timestep        1.0

variable        Tstart equal 450
variable        dT     equal 25
variable        nT     equal 9

thermo          2000
thermo_style    custom step temp press density vol

# 450 K on-dengeleme
velocity        all create ${Tstart} 4928 dist gaussian
fix             pre all npt temp ${Tstart} ${Tstart} 100.0 iso 1.0 1.0 1000.0
run             30000
unfix           pre

# yogunluk ciktisi
variable        Tnow equal temp
variable        dens equal density
fix             out all print 200 "${Tnow} ${dens}" file tg_data.txt screen no title "# T density"

# kademeli sogutma
label           loop
variable        i loop ${nT}
variable        T equal ${Tstart}-(${i}-1)*${dT}
  print         "=== Sicaklik = ${T} K ==="
  fix           run1 all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000.0
  run           40000
  unfix         run1
next            i
jump            SELF loop

print           "==> Tg taramasi tamamlandi"
